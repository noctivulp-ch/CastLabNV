{
  "expo": {
    "name": "CastLab",
    "slug": "CastLab",
    "version": "1.6.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "1.6.0",
      "supportsTablet": true,
      "bundleIdentifier": "app.fedilab.castlab",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "This app requires local network access to discover DLNA devices.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "icon": {
        "dark": "./assets/ios_dark.png",
        "light": "./assets/ios_light.png",
        "tinted": "./assets/ios_tinted.png"
      }
    },
    "android": {
      "versionCode": 15,
      "blockedPermissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android_foreground.png",
        "monochromeImage": "./assets/android_monochrome.png"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK"
      ],
      "package": "app.fedilab.castlab"
    },
    "web": {
      "favicon": "./assets/ec_favicon.png"
    },
    "plugins": [
      [
        "expo-asset",
        {
          "assets": [
            "./assets"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification.png",
          "color": "#ffffff",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-asset",
      "expo-sqlite",
      "expo-localization",
      "./modules/expo-screen-share/app.plugin.js",
      "./modules/expo-share-intent/app.plugin.js",
      "./modules/expo-media-foreground/app.plugin.js",
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "461fe6cd-74d4-4b82-a38f-4a1e4ee3b76e"
      }
    }
  }
}
